{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ES2024", "DOM"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true 
  },
  "include": ["src/**/*"]
}